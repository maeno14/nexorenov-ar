---
import { site, productExternalUrl } from '../config/site';
import LogoMark from './LogoMark.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-canvas">
  <div class="container-nexo px-5 py-9 sm:px-8 sm:py-11 lg:px-12">
    <div class="grid gap-7 md:grid-cols-[1fr_auto] md:items-start">
      <div class="flex max-w-lg gap-4">
        <LogoMark size={42} class="shrink-0" />
        <div>
          <p class="text-lg font-semibold tracking-[-0.03em] text-ink">{site.name}</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Software para operaciones administrativas.
          </p>
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-x-10 gap-y-1 text-sm sm:grid-cols-3" aria-label="Pie de página">
        <a href="#servicios" class="link-muted py-1">Servicios</a>
        <a href="#proceso" class="link-muted py-1">Método</a>
        <a href="#contacto" class="link-muted py-1">Contacto</a>
        <a
          href={productExternalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link-muted py-1"
        >
          {site.product.name}
        </a>
        <a href={`mailto:${site.email}`} class="link-muted col-span-2 py-1">Email</a>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-border pt-6 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}</p>
      <p>Argentina · nexoceler.ar</p>
    </div>
  </div>
</footer>
