---
const services = [
  {
    number: '01',
    title: 'Entender antes de construir',
    description:
      'Relevamos cómo circula la información, dónde se repite trabajo y qué riesgos conviene resolver primero.',
    deliverable: 'Mapa de proceso y prioridades',
    includes: ['Diagnóstico operativo', 'Riesgos y cuellos de botella', 'Plan por etapas'],
  },
  {
    number: '02',
    title: 'Conectar lo que ya funciona',
    description:
      'Integramos sistemas, planillas y documentación para que el equipo deje de mover datos a mano.',
    deliverable: 'Flujo conectado y trazable',
    includes: ['ERP y herramientas actuales', 'Aprobaciones y alertas', 'Datos sin duplicación'],
  },
  {
    number: '03',
    title: 'Automatizar con criterio',
    description:
      'Construimos software e incorporamos IA cuando aporta una mejora concreta al proceso y al control operativo.',
    deliverable: 'Sistema en uso con seguimiento',
    includes: ['Software a medida', 'IA aplicada a documentos', 'Capacitación y soporte'],
  },
];
---

<section id="servicios" class="section-pad border-t border-border bg-surface">
  <div class="container-nexo">
    <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:gap-20">
      <div class="reveal lg:sticky lg:top-28 lg:self-start" style="--index: 0">
        <p class="eyebrow">Cómo ayudamos</p>
        <h2 class="heading-display mt-4 max-w-xl text-4xl font-medium sm:text-5xl lg:text-[3.6rem]">
          De una operación fragmentada a un sistema claro.
        </h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">
          No empezamos por una herramienta. Primero entendemos el proceso, después definimos
          qué conviene integrar, automatizar o construir.
        </p>
        <a href="#proceso" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-blue hover:underline">
          Ver el método de trabajo <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="space-y-4">
        {
          services.map((service, i) => (
            <article class="card reveal overflow-hidden" style={`--index: ${i + 1}`}>
              <div class="grid gap-7 p-6 sm:p-8 md:grid-cols-[1fr_auto] md:items-start">
                <div>
                  <div class="flex items-center gap-4">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-soft font-mono text-xs font-semibold text-blue">
                      {service.number}
                    </span>
                    <h3 class="text-xl font-semibold tracking-[-0.025em] text-ink sm:text-2xl">
                      {service.title}
                    </h3>
                  </div>
                  <p class="mt-5 max-w-xl leading-relaxed text-muted">{service.description}</p>
                  <ul class="mt-6 flex flex-wrap gap-2" aria-label="Incluye">
                    {service.includes.map((item) => <li class="rounded-full border border-border bg-canvas px-3 py-1.5 text-xs text-muted">{item}</li>)}
                  </ul>
                </div>
                <div class="rounded-xl bg-night px-4 py-3 text-white md:w-48">
                  <p class="font-mono text-[0.6rem] uppercase tracking-[0.12em] text-lime">Entregable</p>
                  <p class="mt-2 text-sm leading-snug text-white/80">{service.deliverable}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
