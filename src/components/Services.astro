---
const services = [
  {
    number: '01',
    title: 'Relevar el trabajo como sucede',
    description:
      'Nos sentamos con quienes hacen la tarea. Seguimos archivos, decisiones, excepciones y controles hasta entender dónde se pierde tiempo.',
    deliverable: 'Mapa con responsables, riesgos y prioridades.',
  },
  {
    number: '02',
    title: 'Conectar las herramientas existentes',
    description:
      'Hacemos que el ERP, las planillas, el correo y la documentación intercambien datos sin copiar y pegar entre pantallas.',
    deliverable: 'Flujo conectado, con estados y trazabilidad.',
  },
  {
    number: '03',
    title: 'Construir sólo lo que falta',
    description:
      'Automatizamos o desarrollamos software a medida cuando la operación no se resuelve bien con las herramientas que ya existen.',
    deliverable: 'Sistema probado con casos reales del equipo.',
  },
];
---

<section id="servicios" class="section-pad section-pad-compact bg-canvas">
  <div class="container-nexo">
    <div class="grid gap-10 md:gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-14 xl:gap-20">
      <div class="reveal lg:sticky lg:top-28 lg:self-start" style="--index: 0">
        <h2 class="heading-display max-w-xl text-4xl font-medium sm:text-5xl lg:text-[3.35rem]">
          Primero seguimos el proceso. Después tocamos el sistema.
        </h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">
          Definimos el alcance con quienes hacen la tarea, sobre archivos y casos reales.
        </p>
      </div>

      <ol class="border-y border-border">
        {
          services.map((service, i) => (
            <li class="service-row reveal border-b border-border px-0 py-5 last:border-b-0 sm:py-7 lg:py-8" style={`--index: ${i + 1}`}>
              <div class="grid grid-cols-[3.25rem_minmax(0,1fr)] gap-x-4 gap-y-3 sm:grid-cols-[4rem_minmax(0,1fr)] sm:gap-x-6 sm:gap-y-4 lg:grid-cols-[4.5rem_minmax(0,1fr)] lg:gap-x-6">
                <span class="font-mono text-2xl font-medium leading-none text-blue sm:text-3xl lg:text-[2.5rem]">{service.number}</span>
                <div class="min-w-0">
                  <h3 class="max-w-xl text-[1.35rem] font-semibold leading-[1.05] tracking-[-0.03em] text-ink sm:text-3xl lg:text-[1.85rem]">
                    {service.title}
                  </h3>
                  <p class="mt-3 max-w-xl text-[0.94rem] leading-relaxed text-muted sm:mt-4 sm:text-base">{service.description}</p>
                </div>
                <p class="col-start-2 flex gap-2 border-t border-border pt-3 text-[0.82rem] font-medium leading-relaxed text-ink sm:pt-3.5 sm:text-sm">
                  <span class="font-mono text-blue" aria-hidden="true">↳</span>
                  {service.deliverable}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
