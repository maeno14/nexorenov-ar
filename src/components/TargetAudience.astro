---
const signals = [
  {
    number: '01',
    title: 'La planilla se volvió el sistema',
    description: 'La operación depende de archivos que sólo algunas personas saben mantener.',
  },
  {
    number: '02',
    title: 'El mail funciona como aprobación',
    description: 'Los estados, responsables y decisiones quedan repartidos entre cadenas de mensajes.',
  },
  {
    number: '03',
    title: 'Los sistemas no comparten datos',
    description: 'El equipo copia información entre herramientas y vuelve a controlar cada resultado.',
  },
  {
    number: '04',
    title: 'Crecer agrega trabajo manual',
    description: 'Cada cliente, sucursal o documento nuevo aumenta tareas que ya deberían estar resueltas.',
  },
];
---

<section id="clientes" class="section-pad section-pad-compact border-t border-border bg-surface">
  <div class="container-nexo">
    <div class="reveal grid gap-7 lg:grid-cols-[1fr_0.92fr] lg:items-end lg:gap-16" style="--index: 0">
      <div>
        <h2 class="heading-display text-4xl font-medium sm:text-5xl lg:text-[3.45rem]">
          El problema aparece antes que el nuevo sistema.
        </h2>
      </div>
      <p class="max-w-lg text-lg leading-relaxed text-muted lg:justify-self-end">
        Trabajamos con dirección, operaciones, administración y finanzas de PyMEs en crecimiento,
        empresas medianas y operaciones reguladas. Intervenimos cuando el crecimiento expone
        procesos manuales, información dispersa o falta de trazabilidad.
      </p>
    </div>

    <ol class="mt-8 grid border-t border-border sm:mt-10 md:grid-cols-[1.05fr_0.95fr] md:grid-rows-[repeat(3,minmax(7.5rem,1fr))] lg:mt-12">
      {
        signals.map((signal, i) => (
          <li
            class={`reveal flex flex-col border-b border-border ${
              i === 0
                ? 'min-h-[11rem] bg-canvas-alt p-5 text-ink sm:min-h-[14rem] sm:p-7 md:row-span-3 md:min-h-0 md:p-9'
                : 'grid grid-cols-[2.25rem_minmax(0,1fr)] content-start gap-x-3 bg-surface p-4 sm:min-h-[10rem] sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:gap-x-4 sm:p-6 md:min-h-0 md:border-l md:px-7 md:py-5'
            }`}
            style={`--index: ${i + 1}`}
          >
            <span class="font-mono text-xs text-blue">{signal.number}</span>
            <h3
              class={`leading-[1.08] ${
                i === 0
                  ? 'mt-5 max-w-md text-[1.6rem] font-semibold tracking-[-0.035em] text-ink sm:mt-7 sm:text-3xl lg:text-[2.35rem]'
                  : 'col-start-2 max-w-lg text-[1.05rem] font-semibold tracking-[-0.025em] text-ink sm:text-xl'
              }`}
            >
              {signal.title}
            </h3>
            <p class={`max-w-md leading-relaxed ${i === 0 ? 'mt-auto pt-3 text-[0.88rem] text-muted sm:pt-5 sm:text-[0.95rem]' : 'col-start-2 mt-1.5 text-[0.82rem] text-muted sm:mt-2 sm:text-sm'}`}>
              {signal.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
