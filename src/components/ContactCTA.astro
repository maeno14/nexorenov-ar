---
import { site } from '../config/site';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const hasForm = accessKey.length > 0;
---

<section id="contacto" class="section-pad bg-blue text-white">
  <div class="container-nexo">
    <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-24">
      <div class="reveal" style="--index: 0">
        <p class="font-mono text-[0.68rem] font-medium uppercase tracking-[0.13em] text-white/75">Primer intercambio</p>
        <h2 class="mt-5 max-w-2xl font-serif text-4xl font-medium leading-[0.98] tracking-[-0.04em] sm:text-5xl lg:text-[3.8rem]">
          Mostranos una tarea que hoy se hace a mano.
        </h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/80">
          Con el proceso, las herramientas y un ejemplo alcanza para empezar. Te respondemos
          con las preguntas que faltan y una propuesta de diagnóstico.
        </p>
      </div>

      <div class="reveal lg:border-l lg:border-white/25 lg:pl-14" style="--index: 1">
        {
          hasForm ? (
            <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5 bg-surface p-6 text-ink sm:p-8">
              <input type="hidden" name="access_key" value={accessKey} />
              <input type="hidden" name="subject" value="Consulta desde nexoceler.ar" />
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-2 block text-sm font-medium text-ink">Nombre</label>
                  <input id="name" name="name" type="text" autocomplete="name" required class="input-field" />
                </div>
                <div>
                  <label for="company" class="mb-2 block text-sm font-medium text-ink">Empresa</label>
                  <input id="company" name="company" type="text" autocomplete="organization" class="input-field" />
                </div>
              </div>
              <div>
                <label for="email" class="mb-2 block text-sm font-medium text-ink">Email corporativo</label>
                <input id="email" name="email" type="email" autocomplete="email" required class="input-field" />
              </div>
              <div>
                <label for="message" class="mb-2 block text-sm font-medium text-ink">¿Qué proceso querés revisar?</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="input-field resize-none"
                  placeholder="Por ejemplo: recibimos documentos por mail, los validamos en una planilla y después cargamos los datos en el ERP."
                />
              </div>
              <button type="submit" class="btn-primary w-full">Enviar consulta <span class="btn-arrow" aria-hidden="true">↗</span></button>
            </form>
          ) : (
            <div>
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.12em] text-white/70">Escribinos a</p>
              <a
                href={`mailto:${site.email}?subject=Consulta%20Nexo%20Celer`}
                class="contact-email mt-4 inline-block break-all font-serif text-3xl leading-tight text-white sm:text-4xl"
              >
                {site.email}
              </a>

              <p class="mt-10 border-b border-white/25 pb-4 font-mono text-[0.64rem] uppercase tracking-[0.12em] text-white/70">
                Para entenderlo, nos sirve saber
              </p>
              <ol class="divide-y divide-white/20">
                <li class="grid grid-cols-[2.5rem_1fr] gap-4 py-4 text-sm">
                  <span class="font-mono text-white/60">01</span>
                  <span>Qué tarea se repite y quién la hace.</span>
                </li>
                <li class="grid grid-cols-[2.5rem_1fr] gap-4 py-4 text-sm">
                  <span class="font-mono text-white/60">02</span>
                  <span>Entre qué sistemas, archivos o mails se mueve la información.</span>
                </li>
                <li class="grid grid-cols-[2.5rem_1fr] gap-4 py-4 text-sm">
                  <span class="font-mono text-white/60">03</span>
                  <span>Cuántas veces ocurre y qué pasa cuando algo falla.</span>
                </li>
              </ol>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
