---
import { site } from '../config/site';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const hasForm = accessKey.length > 0;
---

<section id="contacto" class="section-pad border-t border-border bg-canvas">
  <div class="container-nexo">
    <div class="surface-grid reveal overflow-hidden rounded-[1.75rem] bg-blue text-white shadow-[0_30px_90px_rgba(52,92,255,0.22)]" style="--index: 0">
      <div class="grid lg:grid-cols-[0.86fr_1.14fr]">
        <div class="flex flex-col justify-between p-7 sm:p-10 lg:p-12">
          <div>
            <p class="font-mono text-[0.68rem] font-medium uppercase tracking-[0.14em] text-white/85">Primer paso</p>
            <h2 class="mt-5 max-w-xl font-serif text-4xl font-medium leading-[0.98] tracking-[-0.04em] sm:text-5xl lg:text-[3.8rem]">
              Contanos qué parte de la operación hoy depende de trabajo manual.
            </h2>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/85">
              Revisamos el contexto y te respondemos con una propuesta de diagnóstico inicial.
            </p>
          </div>

          <div class="mt-10 border-t border-white/15 pt-6">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.13em] text-white/80">Contacto directo</p>
            <a href={`mailto:${site.email}`} class="mt-2 inline-flex break-all text-sm font-medium text-white hover:underline">
              {site.email}
            </a>
          </div>
        </div>

        <div class="m-3 rounded-[1.35rem] bg-surface p-6 text-ink sm:m-4 sm:p-8 lg:p-10">
          {
            hasForm ? (
              <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
                <input type="hidden" name="access_key" value={accessKey} />
                <input type="hidden" name="subject" value="Consulta desde nexoceler.ar" />
                <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

                <div class="grid gap-5 sm:grid-cols-2">
                  <div>
                    <label for="name" class="mb-2 block text-sm font-medium text-ink">Nombre</label>
                    <input id="name" name="name" type="text" autocomplete="name" required class="input-field" />
                  </div>
                  <div>
                    <label for="company" class="mb-2 block text-sm font-medium text-ink">Empresa</label>
                    <input id="company" name="company" type="text" autocomplete="organization" class="input-field" />
                  </div>
                </div>
                <div>
                  <label for="email" class="mb-2 block text-sm font-medium text-ink">Email corporativo</label>
                  <input id="email" name="email" type="email" autocomplete="email" required class="input-field" />
                </div>
                <div>
                  <label for="message" class="mb-2 block text-sm font-medium text-ink">¿Qué proceso querés revisar?</label>
                  <textarea
                    id="message"
                    name="message"
                    rows="5"
                    required
                    class="input-field resize-none"
                    placeholder="Por ejemplo: recibimos documentos por mail, los validamos en una planilla y después cargamos los datos en el ERP."
                  />
                </div>
                <button type="submit" class="btn-primary w-full">Enviar consulta <span aria-hidden="true">↗</span></button>
              </form>
            ) : (
              <div class="flex h-full min-h-72 flex-col lg:min-h-[28rem]">
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-soft text-xl text-blue" aria-hidden="true">@</span>
                <h3 class="mt-6 text-2xl font-semibold tracking-[-0.03em]">Escribinos por correo</h3>
                <p class="mt-3 max-w-md leading-relaxed text-muted">
                  Describí el proceso, las herramientas que usa tu equipo y dónde aparece el trabajo manual.
                </p>

                <div class="mt-8 rounded-2xl border border-border bg-canvas p-5">
                  <p class="font-mono text-[0.62rem] font-medium uppercase tracking-[0.13em] text-muted">
                    Para orientarnos, incluí
                  </p>
                  <ul class="mt-4 grid gap-3 text-sm text-ink sm:grid-cols-3 lg:grid-cols-1">
                    <li class="flex items-start gap-3">
                      <span class="mt-0.5 font-mono text-xs text-blue" aria-hidden="true">01</span>
                      La tarea que más tiempo consume
                    </li>
                    <li class="flex items-start gap-3">
                      <span class="mt-0.5 font-mono text-xs text-blue" aria-hidden="true">02</span>
                      Las herramientas que intervienen
                    </li>
                    <li class="flex items-start gap-3">
                      <span class="mt-0.5 font-mono text-xs text-blue" aria-hidden="true">03</span>
                      El volumen o la frecuencia del proceso
                    </li>
                  </ul>
                </div>
                <a
                  href={`mailto:${site.email}?subject=Consulta%20Nexo%20Celer`}
                  class="btn-primary mt-8 w-fit lg:mt-auto"
                >
                  Abrir email
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
