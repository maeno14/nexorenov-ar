---
const steps = [
  {
    step: '01',
    title: 'Diagnóstico',
    description:
      'Entrevistamos a quienes operan el proceso y revisamos flujos, datos, excepciones y riesgos.',
    result: 'Mapa del proceso actual',
  },
  {
    step: '02',
    title: 'Diseño',
    description:
      'Definimos la solución, las integraciones necesarias y un alcance que se pueda validar por etapas.',
    result: 'Arquitectura y plan de trabajo',
  },
  {
    step: '03',
    title: 'Implementación',
    description:
      'Construimos y probamos con datos y usuarios del negocio antes de mover la operación.',
    result: 'Sistema funcionando',
  },
  {
    step: '04',
    title: 'Adopción y mejora',
    description:
      'Acompañamos al equipo, medimos el uso y ajustamos el sistema según lo que pasa en la práctica.',
    result: 'Seguimiento y soporte',
  },
];
---

<section id="proceso" class="section-pad overflow-hidden bg-night text-white">
  <div class="container-nexo">
    <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-24">
      <div class="reveal lg:sticky lg:top-28 lg:self-start" style="--index: 0">
        <p class="eyebrow eyebrow-light">Cómo trabajamos</p>
        <h2 class="mt-4 max-w-xl font-serif text-4xl font-medium leading-[1] tracking-[-0.04em] sm:text-5xl lg:text-[3.8rem]">
          Cada etapa termina con algo que podés revisar.
        </h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">
          El proyecto avanza con entregables concretos. Las decisiones quedan visibles antes
          de pasar a la etapa siguiente.
        </p>

        <p class="mt-9 max-w-sm border-l border-lime pl-4 text-sm leading-relaxed text-white/65">
          No pasamos de etapa hasta que el equipo revisa las decisiones.
        </p>
      </div>

      <ol class="border-t border-white/20">
        {
          steps.map((item, i) => (
            <li class="process-row reveal border-b border-white/20 py-7 sm:py-8" style={`--index: ${i + 1}`}>
              <div class="grid gap-5 sm:grid-cols-[3.25rem_1fr] sm:gap-6 lg:grid-cols-[3.25rem_1fr_0.62fr]">
                <span class="font-mono text-xs text-lime">
                  {item.step}
                </span>
                <div>
                  <h3 class="text-xl font-semibold tracking-[-0.025em] sm:text-2xl">{item.title}</h3>
                  <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/78">{item.description}</p>
                </div>
                <div class="sm:col-start-2 lg:col-start-auto lg:text-right">
                  <p class="font-mono text-[0.58rem] uppercase tracking-[0.13em] text-white/70">Resultado</p>
                  <p class="mt-2 text-sm font-medium text-white/85">{item.result}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
