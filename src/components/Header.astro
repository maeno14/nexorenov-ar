---
import { navLinks, site } from '../config/site';
import LogoMark from './LogoMark.astro';
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-canvas/90 backdrop-blur-xl">
  <div class="container-nexo flex min-h-[4.5rem] items-center justify-between gap-2 px-4 sm:gap-5 sm:px-8 lg:px-12">
    <a href="/" class="group flex shrink-0 items-center gap-2 rounded-lg sm:gap-3" aria-label={`${site.name}, inicio`}>
      <LogoMark size={36} class="transition group-hover:rotate-[-3deg]" />
      <span class="hidden leading-[0.95] sm:block">
        <span class="block text-base font-semibold tracking-[-0.03em] text-ink">Nexo</span>
        <span class="block font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted">Celer</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Principal">
      {
        navLinks.map((link) => (
          <a href={link.href} class="link-muted text-sm font-medium">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <details class="relative shrink-0 lg:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-full border border-border bg-surface px-3 text-sm font-medium text-ink sm:px-4 [&::-webkit-details-marker]:hidden">
          Menú
        </summary>
        <nav
          class="absolute left-0 top-full z-50 mt-2 w-[13rem] max-w-[calc(100vw-2rem)] overflow-hidden rounded-2xl border border-border bg-surface p-2 shadow-[0_18px_50px_rgba(17,24,32,0.14)] sm:left-auto sm:right-0 sm:w-auto sm:min-w-[13rem] sm:max-w-none"
          aria-label="Menú móvil"
        >
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="block rounded-xl px-4 py-3 text-sm font-medium text-muted hover:bg-canvas-alt hover:text-ink"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
      <a href="#contacto" class="btn-primary px-3 sm:px-6">
        <span class="sm:hidden">Revisar proceso</span>
        <span class="hidden sm:inline">Revisar un proceso</span>
        <span class="btn-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('header details');

  if (menu) {
    for (const link of menu.querySelectorAll('a')) {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    }

    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.removeAttribute('open');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.removeAttribute('open');
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
