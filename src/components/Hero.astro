---
import LogoMark from './LogoMark.astro';

const inputs = [
  { kind: 'XLS', label: 'Planillas' },
  { kind: '@', label: 'Correos' },
  { kind: 'ERP', label: 'Sistema de gestión' },
];

const outcomes = [
  { label: 'Estado', value: 'visible' },
  { label: 'Responsable', value: 'asignado' },
  { label: 'Historial', value: 'consultable' },
];
---

<section
  aria-labelledby="hero-title"
  class="relative overflow-hidden border-b border-border px-5 pb-14 pt-12 sm:px-8 sm:pb-20 sm:pt-16 lg:px-12"
>
  <div class="container-nexo relative">
    <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:gap-8 xl:grid-cols-[1.02fr_0.98fr] xl:gap-14">
      <div class="reveal relative z-10" style="--index: 0">
        <h1
          id="hero-title"
          class="heading-display max-w-4xl text-[clamp(2.7rem,5.2vw,5.1rem)] font-medium"
        >
          Si el proceso vive entre Excel, mails y un ERP, <span class="text-blue">ahí trabajamos.</span>
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted sm:mt-6 sm:text-xl">
          Relevamos por dónde entran los datos, dónde se vuelven a cargar y quién resuelve cada
          excepción. Después conectamos lo que ya existe y construimos sólo la pieza que falta.
        </p>

        <div class="hero-actions mt-7 flex flex-wrap gap-2 sm:mt-8 sm:gap-3">
          <a href="#contacto" class="btn-primary">
            Revisar un proceso
            <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="#productos" class="btn-secondary">
            Ver constanci.ar
            <span class="btn-arrow btn-arrow-down" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <figure
        class="operation-map reveal relative mx-auto w-full max-w-[38rem]"
        style="--index: 1"
        aria-labelledby="operation-map-title"
      >
        <figcaption id="operation-map-title" class="sr-only">
          De datos dispersos a una operación con estado, responsable e historial
        </figcaption>

        <div class="operation-stage">
          <div class="operation-side operation-side-input">
            <p class="operation-label">Datos dispersos</p>
            <ul class="operation-sources">
              {
                inputs.map((item, i) => (
                  <li class="operation-source" style={`--operation-index: ${i}`}>
                    <span class="operation-source-kind" aria-hidden="true">{item.kind}</span>
                    <span class="operation-source-label">{item.label}</span>
                  </li>
                ))
              }
            </ul>
            <span class="operation-convergence" aria-hidden="true"></span>
          </div>

          <div class="operation-link operation-link-in" aria-hidden="true"></div>

          <div class="operation-core">
            <div class="operation-core-brand">
              <LogoMark size={44} variant="light" />
              <p>Nexo</p>
            </div>
            <p class="operation-core-copy">Conecta<br />y controla</p>
          </div>

          <div class="operation-link operation-link-out" aria-hidden="true"></div>

          <div class="operation-side operation-side-output">
            <p class="operation-label">Operación ordenada</p>
            <div class="operation-record">
              <dl>
                {
                  outcomes.map((item, i) => (
                    <div class="operation-result" style={`--operation-index: ${i}`}>
                      <dt>{item.label}</dt>
                      <dd>{item.value}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero-actions a {
    padding-inline: 1rem;
  }

  .operation-stage {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0.5rem 0.5rem 0.85rem;
  }

  .operation-stage::before {
    position: absolute;
    z-index: -2;
    inset: 30% -0.2rem 0 2.25rem;
    content: '';
    background: var(--color-blue-soft);
  }

  .operation-side {
    position: relative;
    min-width: 0;
  }

  .operation-label {
    position: relative;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .operation-sources {
    position: relative;
    height: 7.35rem;
    margin-top: 0.55rem;
  }

  .operation-convergence {
    display: none;
  }

  .operation-source {
    --source-rotation: 0deg;
    --source-entry-x: -10px;
    position: absolute;
    z-index: 1;
    display: grid;
    width: 90%;
    min-height: 2.95rem;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    border: 1px solid #c9cec8;
    background: white;
    padding: 0.5rem 0.65rem;
    box-shadow: 4px 4px 0 rgba(17, 24, 32, 0.07);
    transform: rotate(var(--source-rotation));
  }

  .operation-source:nth-child(1) {
    --source-rotation: -1.7deg;
    left: 0;
    top: 0;
  }

  .operation-source:nth-child(2) {
    --source-rotation: 1.25deg;
    --source-entry-x: 12px;
    right: 0;
    top: 2.15rem;
    background: var(--color-blue-soft);
    border-color: #c8d2ff;
  }

  .operation-source:nth-child(3) {
    --source-rotation: -0.75deg;
    left: 0.9rem;
    top: 4.3rem;
  }

  .operation-source-kind {
    display: inline-flex;
    width: 1.9rem;
    height: 1.9rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    background: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-blue);
  }

  .operation-source:nth-child(2) .operation-source-kind {
    background: white;
  }

  .operation-source:nth-child(3) .operation-source-kind {
    background: var(--color-ink);
    color: white;
  }

  .operation-source-label {
    min-width: 0;
    font-size: 0.78rem;
    font-weight: 550;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .operation-link {
    position: relative;
    z-index: 0;
    height: 0.8rem;
  }

  .operation-link::before {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    content: '';
    background: var(--color-blue);
    transform-origin: top;
  }

  .operation-link-out::after {
    position: absolute;
    left: calc(50% - 3px);
    bottom: 0;
    width: 7px;
    height: 7px;
    border-bottom: 1px solid var(--color-blue);
    border-right: 1px solid var(--color-blue);
    content: '';
    transform: rotate(45deg);
  }

  .operation-core {
    position: relative;
    z-index: 3;
    display: grid;
    min-height: 6.35rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    background: var(--color-blue);
    padding: 1rem 1.05rem;
    color: white;
    box-shadow: 5px 5px 0 var(--color-ink);
  }

  .operation-core-brand {
    display: flex;
    align-items: center;
    gap: 0.62rem;
  }

  .operation-core-brand p {
    font-size: 1rem;
    font-weight: 650;
  }

  .operation-core-copy {
    justify-self: end;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    line-height: 1.45;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.76);
  }

  .operation-side-output {
    padding-top: 0.15rem;
  }

  .operation-side-output .operation-label {
    margin-bottom: 0.55rem;
  }

  .operation-record {
    position: relative;
    border: 1px solid #c4cac5;
    background: var(--color-surface);
    box-shadow: 5px 5px 0 rgba(52, 92, 255, 0.13);
  }

  .operation-record::before {
    display: block;
    height: 0.42rem;
    content: '';
    background: var(--color-blue);
  }

  .operation-result {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    padding: 0.58rem 0.68rem;
    font-size: 0.75rem;
  }

  .operation-result:last-child {
    border-bottom: 0;
  }

  .operation-result dt {
    color: var(--color-muted);
  }

  .operation-result dd {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    color: var(--color-blue);
  }

  :global(.reveal-ready) .operation-map:not(.is-visible) .operation-source {
    opacity: 0;
    transform: translateX(var(--source-entry-x)) rotate(var(--source-rotation));
  }

  :global(.reveal-ready) .operation-map:not(.is-visible) .operation-core {
    opacity: 0;
    transform: scale(0.94);
  }

  :global(.reveal-ready) .operation-map:not(.is-visible) .operation-record,
  :global(.reveal-ready) .operation-map:not(.is-visible) .operation-result {
    opacity: 0;
    transform: translateY(7px);
  }

  :global(.reveal-ready) .operation-map:not(.is-visible) .operation-link::before {
    transform: scaleY(0);
  }

  :global(.reveal-ready) .operation-map:not(.is-visible) .operation-link-out::after {
    opacity: 0;
  }

  .operation-map.is-visible .operation-source {
    animation: operation-source-in 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(220ms + var(--operation-index, 0) * 90ms);
  }

  .operation-map.is-visible .operation-link::before {
    animation: operation-line-mobile 390ms ease-out 430ms both;
  }

  .operation-map.is-visible .operation-link-out::before {
    animation-delay: 860ms;
  }

  .operation-map.is-visible .operation-core {
    animation: operation-core-in 520ms cubic-bezier(0.16, 1, 0.3, 1) 520ms both;
  }

  .operation-map.is-visible .operation-link-out::after {
    animation: operation-arrow-in 180ms ease-out 1120ms both;
  }

  .operation-map.is-visible .operation-record {
    animation: operation-panel-in 500ms cubic-bezier(0.16, 1, 0.3, 1) 980ms both;
  }

  .operation-map.is-visible .operation-result {
    animation: operation-panel-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(1080ms + var(--operation-index, 0) * 75ms);
  }

  @keyframes operation-source-in {
    from {
      opacity: 0;
      transform: translateX(var(--source-entry-x)) rotate(var(--source-rotation));
    }
    to {
      opacity: 1;
      transform: translateX(0) rotate(var(--source-rotation));
    }
  }

  @keyframes operation-core-in {
    from { opacity: 0; transform: scale(0.94); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes operation-panel-in {
    from { opacity: 0; transform: translateY(7px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes operation-line-mobile {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @keyframes operation-arrow-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (min-width: 640px) {
    .hero-actions a {
      padding-inline: 1.5rem;
    }

    .operation-stage {
      grid-template-columns: minmax(7rem, 0.92fr) 1rem 7.05rem 1rem minmax(7.8rem, 1fr);
      align-items: center;
      padding: 1.25rem 0.25rem 1.6rem;
    }

    .operation-stage::before {
      inset: 1.9rem -0.3rem 0 45%;
    }

    .operation-sources {
      height: 15.4rem;
      margin-top: 0.8rem;
    }

    .operation-source {
      width: calc(100% - 0.45rem);
      min-height: 3.75rem;
      padding: 0.58rem;
    }

    .operation-source::after {
      position: absolute;
      z-index: -1;
      left: calc(100% + 1px);
      top: 50%;
      width: 0.9rem;
      height: 1px;
      content: '';
      background: rgba(52, 92, 255, 0.58);
    }

    .operation-convergence {
      position: absolute;
      z-index: 0;
      right: -0.2rem;
      top: calc(50% - 5rem);
      display: block;
      width: 1px;
      height: 10rem;
      background: rgba(52, 92, 255, 0.58);
    }

    .operation-convergence::after {
      position: absolute;
      left: -2px;
      top: calc(50% - 2px);
      width: 5px;
      height: 5px;
      content: '';
      background: var(--color-blue);
    }

    .operation-source:nth-child(1) {
      top: 1rem;
    }

    .operation-source:nth-child(2) {
      top: 5.65rem;
    }

    .operation-source:nth-child(3) {
      left: 0.4rem;
      top: 10.3rem;
    }

    .operation-link {
      height: 100%;
      min-height: 15.4rem;
    }

    .operation-link::before {
      left: 0;
      right: 0;
      top: 50%;
      bottom: auto;
      width: auto;
      height: 1px;
      transform-origin: left;
    }

    .operation-link-out::after {
      left: auto;
      right: 0;
      top: calc(50% - 3px);
      bottom: auto;
      transform: rotate(-45deg);
    }

    .operation-core {
      min-height: 15.4rem;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      align-items: start;
      gap: 0;
      padding: 0.85rem;
      box-shadow: 6px 6px 0 var(--color-ink);
    }

    .operation-core-brand {
      grid-row: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.7rem;
    }

    .operation-core-brand p {
      font-size: 1.08rem;
    }

    .operation-core-copy {
      grid-row: 2;
      justify-self: start;
      margin-top: 0.35rem;
      text-align: left;
    }

    .operation-side-output {
      padding-top: 1.25rem;
    }

    .operation-result {
      min-height: 4.05rem;
      gap: 0.5rem;
      padding: 0.7rem 0.65rem;
      font-size: 0.73rem;
    }

    :global(.reveal-ready) .operation-map:not(.is-visible) .operation-link::before {
      transform: scaleX(0);
    }

    .operation-map.is-visible .operation-link::before {
      animation-name: operation-line;
    }
  }

  @keyframes operation-line {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .operation-map.is-visible .operation-source,
    .operation-map.is-visible .operation-result,
    .operation-map.is-visible .operation-core,
    .operation-map.is-visible .operation-record,
    .operation-map.is-visible .operation-link::before,
    .operation-map.is-visible .operation-link-out::after {
      animation: none;
    }

    :global(.reveal-ready) .operation-map .operation-source,
    :global(.reveal-ready) .operation-map .operation-core,
    :global(.reveal-ready) .operation-map .operation-record,
    :global(.reveal-ready) .operation-map .operation-result {
      opacity: 1;
    }

    :global(.reveal-ready) .operation-map .operation-source {
      transform: rotate(var(--source-rotation));
    }

    :global(.reveal-ready) .operation-map .operation-core,
    :global(.reveal-ready) .operation-map .operation-record,
    :global(.reveal-ready) .operation-map .operation-result {
      transform: none;
    }

    :global(.reveal-ready) .operation-map .operation-link::before {
      transform: scaleY(1);
    }

    :global(.reveal-ready) .operation-map .operation-link-out::after {
      opacity: 1;
    }

  }

  @media (prefers-reduced-motion: reduce) and (min-width: 640px) {
    :global(.reveal-ready) .operation-map .operation-link::before {
      transform: scaleX(1);
    }
  }
</style>
